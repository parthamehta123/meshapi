RAG_TOP_K=3
MESHAPI_TTS_MODEL=hexgrad/kokoro-82m
MESHAPI_TTS_VOICE=af_heart
MESHAPI_STT_MODEL=elevenlabs/scribe_v1

# Pinecone — only for experiments/02-rag-multiagent.ipynb
PINECONE_API_KEY=your_pinecone_key_here
